@using System.Collections.Generic
@model List<ResultFeatureSliderDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    int count = 0;
    var categoryNames = ViewBag.CategoryNameById as Dictionary<string, string>;
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <div class="bs-example" data-example-id="bordered-table">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Görsel Başlığı</th>
                                <th>Hedef kategori</th>
                                <th>Sil</th>
                                <th>Güncelle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                count++;
                                <tr>
                                    <th scope="row">@count</th>
                                    <td>@item.Title</td>
                                    <td>
                                        @if (string.IsNullOrEmpty(item.CategoryId))
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else if (categoryNames != null && categoryNames.TryGetValue(item.CategoryId, out var cname))
                                        {
                                            @cname
                                        }
                                        else
                                        {
                                            <span title="@item.CategoryId">Kategori</span>
                                        }
                                    </td>
                                    <td><a href="/Admin/FeatureSlider/DeleteFeatureSlider/@item.FeatureSliderId" class="btn btn-danger">Sil</a></td>
                                    <td><a href="/Admin/FeatureSlider/UpdateFeatureSlider/@item.FeatureSliderId" class="btn btn-success">Güncelle</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/Admin/FeatureSlider/CreateFeatureSlider" class="btn btn-primary">Yeni Slider Görsel Girişi</a>
                </div>
            </div>
        </div>
    </div>
</section>