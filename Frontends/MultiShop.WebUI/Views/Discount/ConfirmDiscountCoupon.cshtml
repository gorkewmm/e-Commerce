<div class="col-lg-4">
    <form class="mb-30" asp-controller="Discount" asp-action="ConfirmDiscountCoupon" method="post">
        <div class="input-group">
            <input type="text" name="code" value="@ViewBag.code" class="form-control border-0 p-4" placeholder="Kupon Kodunuz">
            <div class="input-group-append">
                <button class="btn btn-primary">Kuponu Uygula</button>
            </div>
        </div>
    </form>

    <h5 class="section-title position-relative text-uppercase mb-3">
        <span class="bg-secondary pr-3">Sipariş Özeti</span>
    </h5>

    <div class="bg-light p-30 mb-5" id="order-summary">
        <div class="border-bottom pb-2">
            <div class="d-flex justify-content-between mb-1">
                <h6>Ara Toplam</h6>
                <h6><span data-summary="subtotal">@ViewBag.subtotal</span> ₺</h6>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <h6 class="font-weight-medium">KDV Tutarı (%10)</h6>
                <h6 class="font-weight-medium"><span data-summary="tax">@ViewBag.tax</span> ₺</h6>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <h6 class="font-weight-medium">İndirimsiz Tutar (KDV dahil)</h6>
                <h6 class="font-weight-medium"><span data-summary="totalPriceWithTax">@ViewBag.totalPriceWithTax</span> ₺</h6>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <h6 class="font-weight-medium">İndirim Oranı</h6>
                <h6 class="font-weight-medium">% <span data-summary="discountRate">@ViewBag.discountRate</span></h6>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <h6 class="font-weight-medium text-success">İndirim Tutarı</h6>
                <h6 class="font-weight-medium text-success">- <span data-summary="discountAmount">@ViewBag.discountAmount</span> ₺</h6>
            </div>
        </div>
        <div class="pt-2">
            <div class="d-flex justify-content-between mt-2">
                <h5>Ödenecek Tutar</h5>
                <h5><span data-summary="totalNewPriceWithDiscount">@ViewBag.totalNewPriceWithDiscount</span> ₺</h5>
            </div>
            <a href="/Payment/Index" class="btn btn-block btn-primary font-weight-bold my-3 py-3">Ödeme Adımına Geç</a>
        </div>
    </div>
</div>
