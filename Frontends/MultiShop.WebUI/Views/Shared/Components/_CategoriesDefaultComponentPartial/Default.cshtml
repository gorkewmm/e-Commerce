@model List<ResultCategoryDto>
@{
    var counts = ViewBag.ProductCountByCategoryId as Dictionary<string, int> ?? new Dictionary<string, int>();
}

<div class="container-fluid pt-5">
    <h2 class="section-title position-relative text-uppercase mx-xl-5 mb-4">
        <span class="bg-secondary pr-3">Öne Çıkan Kategoriler</span>
    </h2>
    <div class="row px-xl-5 pb-3">
        @foreach (var item in Model)
        {
            var count = counts.TryGetValue(item.CategoryId, out var c) ? c : 0;
            <div class="col-lg-3 col-md-4 col-sm-6 pb-1">
                <a class="text-decoration-none text-reset" href="/ProductList/Index/@item.CategoryId">
                    <div class="cat-item d-flex align-items-center mb-4 p-2 border bg-light">
                        <div class="overflow-hidden flex-shrink-0" style="width: 100px; height: 100px;">
                            <img src="@item.ImageUrl" alt="@item.CategoryName" style="width: 100%; height: 100%; object-fit: cover;">
                        </div>
                        <div class="flex-fill pl-3">
                            <h6 class="mb-1">@item.CategoryName</h6>
                            <small class="text-body">@count Ürün</small>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>
