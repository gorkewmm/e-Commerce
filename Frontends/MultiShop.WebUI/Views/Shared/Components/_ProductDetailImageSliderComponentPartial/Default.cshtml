@model GetByIdProductImageDto

@{
    var images = new List<string>();
    if (Model != null)
    {
        if (!string.IsNullOrWhiteSpace(Model.Image1)) images.Add(Model.Image1);
        if (!string.IsNullOrWhiteSpace(Model.Image2)) images.Add(Model.Image2);
        if (!string.IsNullOrWhiteSpace(Model.Image3)) images.Add(Model.Image3);
        if (!string.IsNullOrWhiteSpace(Model.Image4)) images.Add(Model.Image4);
    }

    if (images.Count == 0)
    {
        images.Add("/images/no-image.png");
    }
}

<div class="col-lg-5 mb-30">
    <div id="product-carousel" class="carousel slide" data-ride="carousel">
        <div class="carousel-inner bg-light">
            @for (int i = 0; i < images.Count; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img class="w-100 h-100" src="@images[i]" alt="Image">
                </div>
            }
        </div>
        @if (images.Count > 1)
        {
            <a class="carousel-control-prev" href="#product-carousel" data-slide="prev">
                <i class="fa fa-2x fa-angle-left text-dark"></i>
            </a>
            <a class="carousel-control-next" href="#product-carousel" data-slide="next">
                <i class="fa fa-2x fa-angle-right text-dark"></i>
            </a>
        }
    </div>
</div>