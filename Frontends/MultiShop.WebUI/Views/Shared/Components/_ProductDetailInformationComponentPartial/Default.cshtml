@model GetByIdProductDetailDto

<div class="tab-pane fade" id="tab-pane-2">
    <h4 class="mb-3">Ürün Bilgileri</h4>
    @if (Model != null && !string.IsNullOrWhiteSpace(Model.ProductInfo))
    {
        <p>@Model.ProductInfo</p>
    }
    else
    {
        <p class="text-muted">Bu ürün için bilgi henüz eklenmemiş.</p>
    }
</div>