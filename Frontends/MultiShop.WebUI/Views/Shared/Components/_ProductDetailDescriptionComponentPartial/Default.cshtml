@model GetByIdProductDetailDto

<div class="tab-pane fade show active" id="tab-pane-1">
    <h4 class="mb-3">Ürün Detayı</h4>
    @if (Model != null && !string.IsNullOrWhiteSpace(Model.ProductDescription))
    {
        <p>@Model.ProductDescription</p>
    }
    else
    {
        <p class="text-muted">Bu ürün için detay bilgisi henüz eklenmemiş.</p>
    }
</div>