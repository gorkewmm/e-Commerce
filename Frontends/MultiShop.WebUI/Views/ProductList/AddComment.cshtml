<style>
    .star-rating {
        display: inline-flex;
        flex-direction: row-reverse;
        font-size: 1.6rem;
        line-height: 1;
    }

    .star-rating input[type="radio"] {
        display: none;
    }

    .star-rating label {
        color: #d0d0d0;
        cursor: pointer;
        padding: 0 2px;
        transition: color 0.15s ease-in-out;
        margin-bottom: 0;
    }

    .star-rating input[type="radio"]:checked ~ label,
    .star-rating label:hover,
    .star-rating label:hover ~ label {
        color: #f5b301;
    }
</style>

<div class="col-md-6">
    <h4 class="mb-4">Bir Yorum Yapın</h4>
    <form method="post" asp-action="AddComment" asp-controller="ProductList">
        <input type="hidden" name="ProductId" value="@ViewData["ProductId"]" />

        <div class="d-flex my-3 align-items-center">
            <p class="mb-0 mr-2">Ürün Puanınız * :</p>
            <div class="star-rating">
                <input type="radio" id="star5" name="Rating" value="5"><label for="star5" title="5 yıldız">&#9733;</label>
                <input type="radio" id="star4" name="Rating" value="4"><label for="star4" title="4 yıldız">&#9733;</label>
                <input type="radio" id="star3" name="Rating" value="3" checked><label for="star3" title="3 yıldız">&#9733;</label>
                <input type="radio" id="star2" name="Rating" value="2"><label for="star2" title="2 yıldız">&#9733;</label>
                <input type="radio" id="star1" name="Rating" value="1"><label for="star1" title="1 yıldız">&#9733;</label>
            </div>
        </div>

        <div class="form-group">
            <label for="message">Yorumunuz *</label>
            <textarea id="message" cols="30" rows="5" class="form-control" name="CommentDetail" placeholder="Ürün hakkında düşüncelerinizi paylaşın..." required></textarea>
        </div>
        <div class="form-group mb-0">
            <input type="submit" value="Yorum Yap" class="btn btn-primary px-3">
        </div>
    </form>
</div>
